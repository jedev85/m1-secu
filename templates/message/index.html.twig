{% extends 'base.html.twig' %}
{% block body %}
<h1>{{ title }}</h1>
<p><a class="button" href="{{ path('message_new') }}">Nouveau message</a> <a href="{{ path('message_sent') }}">Envoyes</a></p>
<table>
    <tr><th>Sujet</th><th>De</th><th>A</th><th>Date</th></tr>
    {% for message in messages %}
        <tr><td><a href="{{ path('message_show', {id: message.id}) }}">{{ message.subject }}</a></td><td>{{ message.sender.email }}</td><td>{{ message.recipient.email }}</td><td>{{ message.createdAt|date('Y-m-d H:i') }}</td></tr>
    {% endfor %}
</table>
{% endblock %}
