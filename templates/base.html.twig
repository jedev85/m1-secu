<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="{{ path('event_index') }}">EventSecure Lab</a>
    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="{{ path('event_index') }}">Evenements</a>
      {% if app.user %}
        <a class="nav-link" href="{{ path('invoice_index') }}">Factures</a>
        <a class="nav-link" href="{{ path('profile_show') }}">Profil</a>
        {% if is_granted('ROLE_ADMIN') %}<a class="nav-link" href="{{ path('admin_dashboard') }}">Admin</a>{% endif %}
        <a class="nav-link" href="{{ path('app_logout') }}">Deconnexion</a>
      {% else %}
        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
        <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
      {% endif %}
    </div>
  </div>
</nav>
<main class="container py-4">
  <div class="alert alert-warning">
    Lab local pedagogique uniquement. Ne jamais deployer en production.
  </div>
  {% for label, messages in app.flashes %}
    {% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}
  {% endfor %}
  {% block body %}{% endblock %}
</main>
</body>
</html>
