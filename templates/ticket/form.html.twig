{% extends 'base.html.twig' %}
{% block body %}
<h1>Nouveau ticket</h1>
<form method="post" class="form">
    <label>Titre <input name="title" value="{{ ticket.title }}"></label>
    <label>Description <textarea name="description">{{ ticket.description }}</textarea></label>
    <label>Priorite <select name="priority"><option>low</option><option selected>normal</option><option>high</option></select></label>
    <label>Client <select name="client_id">{% for client in clients %}<option value="{{ client.id }}">{{ client.name }} - {{ client.owner.email }}</option>{% endfor %}</select></label>
    <button>Creer</button>
</form>
{% endblock %}
