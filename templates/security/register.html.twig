{% extends 'base.html.twig' %}
{% block title %}Inscription{% endblock %}
{% block body %}
<h1>Inscription</h1>
<form method="post" class="col-md-6">
  <input class="form-control mb-2" name="fullName" placeholder="Nom complet" required>
  <input class="form-control mb-2" name="company" placeholder="Organisation">
  <input class="form-control mb-2" type="email" name="email" placeholder="Email" required>
  <input class="form-control mb-3" type="password" name="password" placeholder="Mot de passe" required>
  <button class="btn btn-primary">Créer le compte</button>
</form>
{% endblock %}
