{% extends 'base.html.twig' %}
{% block title %}Profil{% endblock %}
{% block body %}
<h1>Profil</h1>
{% if app.user.avatarPath %}<img src="{{ app.user.avatarPath }}" class="avatar mb-3" alt="avatar">{% endif %}
<dl>
  <dt>Nom</dt><dd>{{ app.user.fullName }}</dd>
  <dt>Email</dt><dd>{{ app.user.email }}</dd>
  <dt>Societe</dt><dd>{{ app.user.company }}</dd>
  <dt>Telephone</dt><dd>{{ app.user.phone }}</dd>
  <dt>Roles</dt><dd>{{ app.user.roles|join(', ') }}</dd>
</dl>
<a class="btn btn-primary" href="{{ path('profile_edit') }}">Modifier</a>
<hr>
<h2 class="h4">Mes inscriptions</h2>
{% if app.user.registrations|length > 0 %}
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Evenement</th>
        <th>Date</th>
        <th>Statut</th>
        <th>Inscrit le</th>
      </tr>
    </thead>
    <tbody>
    {% for registration in app.user.registrations %}
      <tr>
        <td><a href="{{ path('event_show', {id: registration.event.id}) }}">{{ registration.event.title }}</a></td>
        <td>{{ registration.event.startsAt|date('d/m/Y H:i') }}</td>
        <td>{{ registration.status }}</td>
        <td>{{ registration.registeredAt|date('d/m/Y H:i') }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% else %}
  <p>Aucune inscription pour le moment.</p>
{% endif %}
{% endblock %}
