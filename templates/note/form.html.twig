{% extends 'base.html.twig' %}
{% block body %}
<h1>Note interne</h1>
<form method="post" class="form">
    <label>Titre <input name="title" value="{{ note.title }}"></label>
    <label>Contenu <textarea name="content">{{ note.content }}</textarea></label>
    <label>Visibilite <select name="visibility"><option>private</option><option>team</option><option>public</option><option>management</option></select></label>
    <label>Client <select name="client_id"><option></option>{% for client in clients %}<option value="{{ client.id }}">{{ client.name }}</option>{% endfor %}</select></label>
    <label>Projet <select name="project_id"><option></option>{% for project in projects %}<option value="{{ project.id }}">{{ project.name }}</option>{% endfor %}</select></label>
    <button>Enregistrer</button>
</form>
{% endblock %}
