{% extends 'base.html.twig' %}
{% block title %}{{ event.title }}{% endblock %}
{% block body %}
<h1>{{ event.title }}</h1>
<p class="lead">{{ event.location }} - {{ event.startsAt|date('d/m/Y H:i') }}</p>
<p>{{ event.description }}</p>
<div class="row g-3 mb-4">
  <div class="col-md-8">
    <div class="border rounded p-3 bg-light">
      <strong>Inscriptions</strong>
      <div>{{ registrationCount }} inscrit(s) / {{ event.capacity }} places</div>
      <div>{{ remainingSeats }} place(s) restantes</div>
      {% if registration %}
        <div class="badge text-bg-success mt-2">Vous etes inscrit depuis le {{ registration.registeredAt|date('d/m/Y H:i') }}</div>
      {% endif %}
    </div>
  </div>
  <div class="col-md-4">
    {% if app.user %}
      {% if registration %}
        <a class="btn btn-outline-primary w-100" href="{{ path('invoice_index') }}">Voir mes factures</a>
      {% else %}
        <form method="post" action="{{ path('event_register', {id: event.id}) }}">
          <button class="btn btn-success w-100">S’inscrire</button>
        </form>
      {% endif %}
    {% else %}
      <a class="btn btn-success w-100" href="{{ path('app_login') }}">Se connecter pour s’inscrire</a>
    {% endif %}
  </div>
</div>
<hr>
<section class="mb-4" id="lab">
  <h2 class="h4">Atelier associé: {{ lab.theme }}</h2>
  <p><span class="badge text-bg-secondary">{{ lab.estimatedTime }}</span></p>
  <p>{{ lab.goal }}</p>
  <div class="border rounded p-3 mb-3 bg-light">
    <strong>Scénario</strong>
    <p class="mb-0">{{ lab.scenario }}</p>
  </div>
  <div class="row g-3">
    <div class="col-md-5">
      <div class="border rounded p-3 h-100">
        <strong>Zones de test</strong>
        <ul class="mb-0">
          {% for entrypoint in lab.entrypoints %}
            <li><a href="{{ entrypoint.href }}">{{ entrypoint.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="col-md-7">
      <div class="border rounded p-3 h-100">
        <strong>Travail attendu</strong>
        <ol class="mb-0">
          {% for task in lab.tasks %}
            <li>{{ task }}</li>
          {% endfor %}
        </ol>
      </div>
    </div>
  </div>
  <div class="row g-3 mt-1">
    <div class="col-md-4">
      <div class="border rounded p-3 h-100">
        <strong>Notions travaillées</strong>
        <ul class="mb-0">
          {% for concept in lab.concepts %}
            <li>{{ concept }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="col-md-8">
      <div class="border rounded p-3 h-100">
        <strong>Parcours progressif</strong>
        <div class="table-responsive mt-2">
          <table class="table table-sm align-middle mb-0">
            <tbody>
              {% for level in lab.levels %}
                <tr>
                  <th scope="row" class="text-nowrap">{{ level[0] }}</th>
                  <td>{{ level[1] }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="row g-3 mt-1">
    <div class="col-md-4">
      <div class="border rounded p-3 h-100">
        <strong>Livrables</strong>
        <ul class="mb-0">
          {% for deliverable in lab.deliverables %}
            <li>{{ deliverable }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="col-md-4">
      <div class="border rounded p-3 h-100">
        <strong>Vérification attendue</strong>
        <ul class="mb-0">
          {% for check in lab.checks %}
            <li>{{ check }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="col-md-4">
      <div class="border rounded p-3 h-100">
        <strong>Points de vigilance</strong>
        <ul class="mb-0">
          {% for item in lab.vigilance %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
<hr>
<h2 class="h4" id="comments">Commentaires</h2>
{% if app.user %}
<form method="post" action="{{ path('comment_create', {id: event.id}) }}" class="mb-3">
  <textarea class="form-control mb-2" name="content" rows="3" placeholder="Votre commentaire"></textarea>
  <button class="btn btn-primary">Publier</button>
</form>
{% endif %}
{% for comment in event.comments %}
  <div class="comment">
    <strong>{{ comment.author.fullName }}</strong>
    <small>{{ comment.createdAt|date('d/m/Y H:i') }}</small>
    <div>{{ comment.content|raw }}</div>
    {% if app.user %}
    <form method="post" action="{{ path('comment_delete', {id: comment.id}) }}">
      <button class="btn btn-sm btn-outline-danger">Supprimer</button>
    </form>
    {% endif %}
  </div>
{% endfor %}
{% endblock %}
