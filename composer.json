{
  "name": "eventsecure/eventsecure-lab",
  "description": "Application Symfony volontairement vulnerable pour un module M1 cybersecurite.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/dbal": "^3.8",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.2",
    "symfony/asset": "^7.2",
    "symfony/console": "^7.2",
    "symfony/dotenv": "^7.2",
    "symfony/expression-language": "^7.2",
    "symfony/flex": "^2",
    "symfony/form": "^7.2",
    "symfony/framework-bundle": "^7.2",
    "symfony/http-client": "^7.2",
    "symfony/mime": "^7.2",
    "symfony/monolog-bundle": "^3.10",
    "symfony/runtime": "^7.2",
    "symfony/security-bundle": "^7.2",
    "symfony/serializer": "^7.2",
    "symfony/twig-bundle": "^7.2",
    "symfony/validator": "^7.2",
    "symfony/yaml": "^7.2",
    "twig/extra-bundle": "^3.10",
    "twig/twig": "^3.10"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.6",
    "phpunit/phpunit": "^11.0",
    "symfony/browser-kit": "^7.2",
    "symfony/css-selector": "^7.2",
    "symfony/maker-bundle": "^1.60",
    "symfony/phpunit-bridge": "^7.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.2.*"
    }
  }
}
